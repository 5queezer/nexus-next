{
  "name": "80-documents",
  "resetDb": true,
  "calls": [
    {
      "tool": "create_application",
      "args": {
        "company": "Parity Doc Labs",
        "role": "Parity Engineer"
      },
      "save": {
        "app": "."
      },
      "expect": {
        "isError": false
      }
    },
    {
      "tool": "create_application",
      "args": {
        "company": "Parity Doc Other",
        "role": "Parity Engineer"
      },
      "save": {
        "other": "."
