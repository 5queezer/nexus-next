      "expect": {
        "isError": false
      }
    },
    {
      "tool": "upload_document_content",
      "args": {
        "filename": "parity.pdf",
        "mimeType": "application/pdf",
        "contentBase64": "JVBERi0xLjQKJSVFT0YK",
