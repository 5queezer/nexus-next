{
  "name": "60-upsert-job-url",
  "resetDb": true,
  "calls": [
    {
      "tool": "find_application_by_job_url",
      "args": {
        "jobUrl": "https://jobs.parity.invalid/role/1"
      },
      "expect": {
        "paths": {
          "application": null
        }
      }
    },
    {
      "tool": "upsert_application_by_job_url",
      "args": {
        "company": "Parity Upsert",
        "role": "R",
        "jobUrl": "https://jobs.parity.invalid/role/1",
        "dryRun": true
      },
      "expect": {
        "paths": {
          "dryRun": true,
          "operation": "create",
          "existingId": null
        }
      }
    },
    {
      "tool": "find_application_by_job_url",
