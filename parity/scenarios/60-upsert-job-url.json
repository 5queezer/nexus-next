        "company": "Parity Upsert",
        "role": "R",
        "jobUrl": "https://jobs.parity.invalid/role/1",
        "notes": "first",
        "source": {
          "$repeat": [
            "s",
            100
          ]
        },
        "rating": 2,
        "salaryMin": 10,
        "salaryMax": 20
      },
      "save": {
        "created": "."
